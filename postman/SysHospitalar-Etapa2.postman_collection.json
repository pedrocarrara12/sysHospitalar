        }
      ]
    },
    {
      "name": "04 - Cenarios de erro",
      "item": [
        {
          "name": "Paciente inexistente ao criar atendimento pela principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Paciente inexistente retorna 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHoraAtendimento\": \"2026-08-30T20:30:00\",\n  \"tipoAtendimento\": \"URGENCIA\",\n  \"statusAtendimento\": \"ANDAMENTO\",\n  \"pacienteId\": 999999,\n  \"medicoId\": {{medicoId}}\n}"
            },
            "url": {
              "raw": "{{baseUrlPrincipal}}/atendimentos",
              "host": [
                "{{baseUrlPrincipal}}"
              ],
              "path": [
                "atendimentos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Servico de atendimentos indisponivel pela principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Com atendimentos-service desligado, retorna 503', function () {",
                  "  pm.response.to.have.status(503);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Antes de executar este request, desligue o atendimentos-service e mantenha a aplicacao principal ligada.",
            "url": {
              "raw": "{{baseUrlPrincipal}}/atendimentos",
              "host": [
                "{{baseUrlPrincipal}}"
              ],
              "path": [
                "atendimentos"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Resposta nao deve conter stack trace', function () {",
          "  const text = pm.response.text();",
          "  pm.expect(text).to.not.include('java.lang');",
          "  pm.expect(text).to.not.include('feign.');",
          "});"
        ]
      }
    }
  ]
