          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlAtendimentos}}/atendimentos/filtro/tipo?tipo=INTERNACAO",
              "host": [
                "{{baseUrlAtendimentos}}"
              ],
              "path": [
                "atendimentos",
                "filtro",
                "tipo"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "INTERNACAO"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar ordenados por data direto no servico",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlAtendimentos}}/atendimentos/ordenados-por-data",
              "host": [
                "{{baseUrlAtendimentos}}"
              ],
              "path": [
