# Copie este arquivo para .env antes da execucao com Docker Compose.
# Substitua apenas as senhas ilustrativas por valores locais.

# Portas publicadas somente no computador local
CONFIG_SERVER_PORT=8888
SYSHOSPITALAR_SERVER_PORT=8080
ATENDIMENTOS_SERVER_PORT=8081
SYSHOSPITALAR_DB_PORT=5432
ATENDIMENTOS_DB_PORT=5433

# Banco da aplicacao principal
SYSHOSPITALAR_DB_NAME=syshospitalar
SYSHOSPITALAR_DB_USERNAME=syshospitalar
SYSHOSPITALAR_DB_PASSWORD=defina-uma-senha-local

# Banco do servico de atendimentos
ATENDIMENTOS_DB_NAME=atendimentos
ATENDIMENTOS_DB_USERNAME=atendimentos
ATENDIMENTOS_DB_PASSWORD=defina-outra-senha-local

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=syshospitalar
RABBITMQ_PASSWORD=defina-uma-senha-para-o-rabbitmq

# Gmail SMTP - use uma senha de aplicativo, nunca a senha comum da conta
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=defina-uma-senha-de-aplicativo
MAIL_FROM=seu-email@gmail.com

# Notificacoes e arquivos temporarios do Batch
NOTIFICACOES_CONSUMIDOR_ATIVO=true
NOTIFICACOES_EXCHANGE=atendimentos.exchange
NOTIFICACOES_ROUTING_KEY=atendimento.criado
NOTIFICACOES_QUEUE=notificacao-email.atendimento-criado
NOTIFICACOES_DLX=atendimentos.dlx
NOTIFICACOES_DLQ=notificacao-email.atendimento-criado.dlq
NOTIFICACOES_DLQ_ROUTING_KEY=atendimento.criado.falhou
BATCH_INPUT_DIR=/tmp/syshospitalar/batch
