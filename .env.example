# Copie este arquivo para .env antes da execucao com Docker Compose.
# O Compose devera mapear as variaveis prefixadas para DB_URL,
# DB_USERNAME, DB_PASSWORD e SERVER_PORT dentro de cada container.

# Profile usado pelas aplicacoes quando executadas em containers
SPRING_PROFILES_ACTIVE=prod

# Portas publicadas
CONFIG_SERVER_PORT=8888
SYSHOSPITALAR_SERVER_PORT=8080
ATENDIMENTOS_SERVER_PORT=8081

# Enderecos internos da rede Docker
CONFIG_SERVER_URL=http://config-server:8888
ATENDIMENTOS_SERVICE_URL=http://atendimentos-service:8081

# Banco da aplicacao principal
SYSHOSPITALAR_DB_NAME=syshospitalar
SYSHOSPITALAR_DB_URL=jdbc:postgresql://postgres-principal:5432/syshospitalar
SYSHOSPITALAR_DB_USERNAME=syshospitalar
SYSHOSPITALAR_DB_PASSWORD=defina-uma-senha-local

# Banco do servico de atendimentos
ATENDIMENTOS_DB_NAME=atendimentos
ATENDIMENTOS_DB_URL=jdbc:postgresql://postgres-atendimentos:5432/atendimentos
ATENDIMENTOS_DB_USERNAME=atendimentos
ATENDIMENTOS_DB_PASSWORD=defina-outra-senha-local

# Comportamento do Hibernate e dos logs SQL
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
